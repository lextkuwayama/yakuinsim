# 役員報酬シミュレーター
# ローカル開発: start.bat / start.ps1 で API(8002) + UI(3002) を起動
# 静的公開: NEXT_PUBLIC_SIM_OFFICER_API_URL で Vercel API を直呼び

# --- ローカル開発用（rewrite 経由）---
SIM_OFFICER_API_URL=http://localhost:8002

# --- 静的公開用（ビルド時に埋め込み）---
# NEXT_PUBLIC_SIM_OFFICER_API_URL=https://your-api.vercel.app
# NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-528TGMTT

# --- API 側 ---
SIM_OFFICER_CORS_ORIGINS=http://localhost:3002,https://sozoku.prolext.jp,https://lextkuwayama.github.io

# --- 任意: パートナー表示 ---
# NEXT_PUBLIC_EXEC_COMP_PARTNER_NAME=〇〇税理士法人
# NEXT_PUBLIC_EXEC_COMP_PARTNER_SITE_URL=https://partner.example.com
# NEXT_PUBLIC_EXEC_COMP_POWERED_BY_URL=https://prolext.jp/
# NEXT_PUBLIC_EXEC_COMP_POWERED_BY_LABEL=PROLEXT
# NEXT_PUBLIC_EXEC_COMP_CONSULTATION_URL=https://u.prolextol.jp/line/open/...
# NEXT_PUBLIC_EXEC_COMP_CONSULTATION_LABEL=自社に合った最適な役員報酬を無料診断する
# NEXT_PUBLIC_EXEC_COMP_APP_VERSION=v0.2.9
